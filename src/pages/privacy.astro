---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SkipLink from '../components/layout/SkipLink.astro';

const SITE_URL = import.meta.env.PUBLIC_SITE_URL || 'https://seniorcareexplained.com';
const lastUpdated = 'October 2026';
---

<BaseLayout
  title="Privacy Policy | Senior Care Explained"
  description="Privacy policy for Senior Care Explained. Learn what data we collect and how we use it."
  canonical={`${SITE_URL}/privacy/`}
  robots="noindex,follow"
>
  <SkipLink />
  <Header />
  <main id="main-content" role="main">
    <div class="u-container u-py-16" style="max-width: 780px; margin: 0 auto;">
      <header class="u-mb-12">
        <p class="c-eyebrow">Legal</p>
        <h1 style="font-family: var(--sl-font-serif);">Privacy Policy</h1>
        <p class="u-text-muted u-mt-2">Last updated: {lastUpdated}</p>
      </header>
      <section class="u-mb-10">
        <h2>Overview</h2>
        <p>
          Senior Care Explained ("the Site") is committed to protecting your privacy. This policy
          explains what information is collected when you visit the Site and how it is used.
        </p>
        <p>
          We do not sell the personal information we collect ourselves, such as messages sent
          through our forms. This Site shows advertising from Google AdSense, and Google and its
          partners may use cookies and similar technologies when you view those ads. This is
          explained in the sections below.
        </p>
      </section>
      <section class="u-mb-10">
        <h2>Information We Collect</h2>
        <p>
          This Site does not require registration or login. We do not publish any email address; the
          only way to write to us is through the forms on the Site.
        </p>
        <p>
          <strong>Contact messages and accessibility reports:</strong> If you send us a message or
          submit an accessibility report through a form on this Site, we collect the information you
          provide (such as your email address, the page URL, and your message). This data is
          processed by{' '}
          <a href="https://formspree.io/legal/privacy-policy/" target="_blank" rel="noopener">
            Formspree
          </a>{' '}
          and sent to us by email. We use it solely to answer you and to fix errors and
          accessibility issues, and do not share it with third parties.
        </p>
        <p>
          When you visit the Site, Cloudflare Pages — our hosting provider — automatically collects
          standard server logs including IP addresses, browser type, and pages visited. This data is
          used solely for security and performance purposes and is governed by{' '}
          <a href="https://www.cloudflare.com/privacypolicy/" target="_blank" rel="noopener">
            Cloudflare's Privacy Policy
          </a>
          .
        </p>
        <p>
          <strong>Analytics:</strong> We use{' '}
          <a href="https://policies.google.com/privacy" target="_blank" rel="noopener">
            Google Analytics
          </a>{' '}
          to understand how visitors use the Site (for example, pages viewed, approximate location,
          device type, and how visitors arrived). Google receives this usage data and your IP
          address as part of the service. We use it only to improve our content.
        </p>
      </section>
      <section class="u-mb-10">
        <h2>Cookies and Similar Technologies</h2>
        <p>This Site uses a small number of cookies and similar technologies:</p>
        <ul>
          <li>
            <strong>Analytics cookies.</strong> Google Analytics sets cookies in your browser to
            measure how many people visit and which pages they read. This data is aggregated and is
            not used to identify you personally. You can install the{' '}
            <a href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noopener">
              Google Analytics opt-out browser add-on
            </a>
            .
          </li>
          <li>
            <strong>Technical cookies.</strong> Our hosting provider, Cloudflare, may set cookies
            that are necessary for security and performance. These cookies do not identify you
            personally.
          </li>
          <li>
            <strong>Your display choice.</strong> If you switch between light and dark mode, your
            browser stores that choice on your device. We do not receive it.
          </li>
          <li>
            <strong>Advertising cookies.</strong> Google and its partners may place and read cookies
            in your browser when ads are shown on the Site. See "Advertising" below.
          </li>
        </ul>
      </section>
      <section class="u-mb-10">
        <h2>Advertising</h2>
        <p>
          This Site is supported by advertising. We use Google AdSense to show ads. We do not choose
          ads based on your personal information, and advertisers have no influence on what we
          write.
        </p>
        <p>
          Third-party vendors, including Google, use cookies to serve ads based on your prior visits
          to this Site or other websites. Google's use of advertising cookies enables it and its
          partners to serve ads to you based on your visit to this Site and other sites on the
          internet.
        </p>
        <p>
          To learn how Google uses data when you use our partners' sites or apps, see{' '}
          <a
            href="https://policies.google.com/technologies/partner-sites"
            target="_blank"
            rel="noopener"
          >
            How Google uses data when you use our partners' sites or apps
          </a>
          .
        </p>
        <p>
          If we add other advertising companies in the future, we will name them on this page and
          link to their privacy information.
        </p>
      </section>
      <section class="u-mb-10">
        <h2>Your Choices About Ads</h2>
        <ul>
          <li>
            <strong>Turn off personalized ads from Google.</strong> Visit{' '}
            <a href="https://adssettings.google.com" target="_blank" rel="noopener">
              Google Ads Settings
            </a>
            . When personalization is off, you may still see ads, but they will not be based on your
            interests.
          </li>
          <li>
            <strong>Opt out of other companies' personalized ads.</strong> Visit{' '}
            <a href="https://www.aboutads.info/choices/" target="_blank" rel="noopener">
              aboutads.info/choices
            </a>{' '}
            to opt out of personalized advertising from participating third-party vendors.
          </li>
          <li>
            <strong>Use your browser settings.</strong> You can block or delete cookies in your
            browser settings. Some parts of the Site may work differently if you do, and you may
            still see ads that are not personalized.
          </li>
        </ul>
      </section>
      <section class="u-mb-10">
        <h2>U.S. State Privacy Rights</h2>
        <p>
          Depending on where you live, you may have rights about your personal information, such as
          the right to know what is collected, to ask for deletion, and to opt out of the sharing of
          your information for targeted advertising. You can use the ad settings described above for
          advertising. For information we collect ourselves, such as a message you send us, you can
          ask us to delete or correct it through the <a href="/contact/">contact page</a>.
        </p>
        <p>We do not knowingly sell the personal information we collect ourselves.</p>
      </section>
      <section class="u-mb-10">
        <h2>Third-Party Links</h2>
        <p>
          This Site contains links to external websites including government agencies, nonprofits,
          and research organizations. We are not responsible for the privacy practices of those
          sites. We encourage you to review their privacy policies before providing any personal
          information.
        </p>
      </section>
      <section class="u-mb-10">
        <h2>Children's Privacy</h2>
        <p>
          This Site is not directed at children under the age of 13 and does not knowingly collect
          personal information from children.
        </p>
      </section>
      <section class="u-mb-10">
        <h2>Your Rights</h2>
        <p>
          We ourselves do not collect personal data unless you send it to us through a form (our
          hosting provider's server logs are described above). If you sent us a message, you can ask
          us to delete it or correct it by writing to us again through the{' '}
          <a href="/contact/">contact page</a>. We keep messages only as long as needed to answer
          them and to make any correction they lead to.
        </p>
        <p>
          If you have concerns about data collected by Cloudflare, please refer to their{' '}
          <a href="https://www.cloudflare.com/privacypolicy/" target="_blank" rel="noopener">
            privacy policy
          </a>{' '}
          and data subject request process.
        </p>
      </section>
      <section class="u-mb-10">
        <h2>Changes to This Policy</h2>
        <p>
          We may update this Privacy Policy when we add new features or services, such as new
          advertising partners, analytics tools, or a newsletter. The date at the top of this page
          shows the most recent revision.
        </p>
      </section>
      <section>
        <h2>Contact</h2>
        <p>
          If you have questions about this Privacy Policy, you can reach us through the{' '}
          <a href="/contact/">contact page</a>.
        </p>
      </section>
    </div>
  </main>
  <Footer />
</BaseLayout>
