---
import { getCollection } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { buildSEOMeta, generateArticleJsonLd } from '../../utils/seo';
import { getTableOfContents, addHeadingAnchors } from '../../utils/markdown';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('entries');
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'entries'> };
const { data, body, slug } = entry;

const processedContent = addHeadingAnchors(body);
const tocHeadings = getTableOfContents(body);

const seoMeta = buildSEOMeta(entry);
const jsonLd = generateArticleJsonLd(entry);
---
<ArticleLayout
  title={seoMeta.title}
  description={seoMeta.description}
  data={data}
  slug={slug}
  content={processedContent}
  canonical={seoMeta.canonical}
  ogImage={seoMeta.ogImage}
  jsonLd={jsonLd}
  robots={seoMeta.robots}
/>