---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SkipLink from '../components/layout/SkipLink.astro';

const SITE_URL = import.meta.env.PUBLIC_SITE_URL || 'https://senior-living-options.pages.dev';
const lastUpdated = new Date().toLocaleDateString('en-US', { month: 'long', year: 'numeric' });

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Editorial Policy',
  url: `${SITE_URL}/editorial-policy/`,
  description:
    'How Senior Living Options chooses sources, reviews figures, and corrects mistakes, and what this site is not.',
  publisher: { '@type': 'Organization', name: 'Senior Living Options', url: SITE_URL },
};
---

<BaseLayout
  title="Editorial Policy | Senior Living Options"
  description="How Senior Living Options chooses sources, reviews figures, and corrects mistakes, and what this site is not."
  canonical={`${SITE_URL}/editorial-policy/`}
  jsonLd={jsonLd}
>
  <SkipLink />
  <Header />
  <main id="main-content" role="main">
    <div class="u-container u-py-16" style="max-width: 780px; margin: 0 auto;">
      <header class="u-mb-12">
        <p class="c-eyebrow">About</p>
        <h1 style="font-family: var(--sl-font-serif);">Editorial Policy</h1>
        <p class="u-text-muted u-mt-2">Last updated: {lastUpdated}</p>
      </header>

      <section class="u-mb-10">
        <h2>Who writes this site</h2>
        <p>
          Senior Living Options is an independent editorial project. Articles are published under
          the name of the site rather than under an individual author. The people behind the site
          are not doctors, nurses, lawyers, or financial advisors, and we do not claim any
          professional credentials. We organize and explain information from official and published
          sources so families can understand their options.
        </p>
      </section>

      <section class="u-mb-10">
        <h2>Where our information comes from</h2>
        <ul>
          <li>
            <strong>Official sources first:</strong> government and agency sources such as
            Medicare.gov, Medicaid.gov, the Social Security Administration, the CDC, and state
            Medicaid agencies.
          </li>
          <li>
            <strong>Published surveys for cost figures:</strong> for example, the CareScout 2025
            Cost of Care Survey. The source and year are named wherever a figure appears.
          </li>
          <li>
            <strong>Sources are listed:</strong> each article shows the sources it relies on and the
            date it was last reviewed.
          </li>
          <li>
            <strong>No law-firm blogs or calculators as a source of a figure.</strong> We may use
            them to find where to look, but never as the citation.
          </li>
        </ul>
      </section>

      <section class="u-mb-10">
        <h2>How we handle figures</h2>
        <p>
          Costs, Medicaid limits, and similar numbers change. We review them at least once a year.
          On our state pages, a Medicaid figure is shown only when it was read in an official
          document, and it appears with its source and the date we checked it. When we could not
          verify a state's figures, we say so instead of showing an unconfirmed number. Where an
          official source gives conflicting information, we point it out.
        </p>
      </section>

      <section class="u-mb-10">
        <h2>Independence</h2>
        <p>
          We do not list, rank, or recommend individual facilities or providers, and we do not
          accept payment from them. The site may show advertising. Advertisers have no influence on
          what we write. We do not use affiliate links.
        </p>
      </section>

      <section class="u-mb-10">
        <h2>Corrections</h2>
        <p>
          If you find a mistake or an outdated figure, please
          <a href="/contact/">tell us</a>. We will check it against the official source and fix it,
          and we update the review date on the page when we do.
        </p>
      </section>

      <section>
        <h2>What this site is not</h2>
        <p>
          Nothing on this site is medical, legal, or financial advice, and it cannot replace a
          conversation with a qualified professional or the agency that decides your eligibility.
          See our <a href="/disclaimer/">disclaimer</a>.
        </p>
      </section>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  section a,
  main p a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
