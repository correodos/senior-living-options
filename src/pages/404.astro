---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SkipLink from '../components/layout/SkipLink.astro';
import { getAllCategories } from '../utils/category';
const categories = getAllCategories();
---

<BaseLayout
  title="Page Not Found | Senior Living Options"
  description="The page you were looking for doesn't exist. Browse our guides on senior care options."
  robots="noindex,follow"
>
  <SkipLink />
  <Header />
  <main id="main-content" role="main">
    <div class="u-container u-py-16" style="max-width: 700px; margin: 0 auto; text-align: center;">
      <p style="font-size: 5rem; font-weight: 700; color: var(--sl-color-primary); margin: 0;">
        404
      </p>
      <h1 style="font-family: var(--sl-font-serif); font-size: var(--sl-fs-3xl); margin: var(--sl-space-4) 0;">
        Page not found
      </h1>
      <p style="color: var(--sl-color-text-muted); margin-bottom: var(--sl-space-10);">
        The page you were looking for doesn't exist or has been moved. Browse our guides below to
        find what you need.
      </p>
      <a href="/" class="c-btn c-btn--primary c-btn--lg" style="margin-bottom: var(--sl-space-12);">
        Back to home
      </a>
      <div style="margin-top: var(--sl-space-12); text-align: center;">
        <h2 style="font-family: var(--sl-font-serif); font-size: var(--sl-fs-xl); margin-bottom: var(--sl-space-6);">
          Browse our guides
        </h2>
        <div class="c-grid c-grid--2 u-gap-4">
          {categories.map((cat) => (
            <a href={`/category/${cat.slug}/`} class="c-btn c-btn--outline c-btn--full">
              {cat.icon} {cat.label}
            </a>
          ))}
        </div>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
