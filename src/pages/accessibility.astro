---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SkipLink from '../components/layout/SkipLink.astro';

const SITE_URL = import.meta.env.PUBLIC_SITE_URL || 'https://senior-living-options.pages.dev';
const lastUpdated = 'October 2026';
---

<BaseLayout
  title="Accessibility | Senior Living Options"
  description="Our commitment to web accessibility and how to report accessibility issues on Senior Living Options."
  canonical={`${SITE_URL}/accessibility/`}
  robots="noindex,follow"
>
  <SkipLink />
  <Header />
  <main id="main-content" role="main">
    <div class="u-container u-py-16" style="max-width: 780px; margin: 0 auto;">
      <header class="u-mb-12">
        <p class="c-eyebrow">Legal</p>
        <h1 style="font-family: var(--sl-font-serif);">Accessibility</h1>
        <p class="u-text-muted u-mt-2">Last updated: {lastUpdated}</p>
      </header>
      <section class="u-mb-10">
        <h2>Our Commitment</h2>
        <p>
          Senior Living Options is committed to making its content accessible to everyone, including
          people with visual, motor, or cognitive disabilities. Many of our readers are older adults
          or family caregivers — we take accessibility seriously.
        </p>
      </section>
      <section class="u-mb-10">
        <h2>What We Have Done</h2>
        <ul>
          <li>Semantic HTML structure with proper heading hierarchy</li>
          <li>Skip navigation link to bypass repeated content</li>
          <li>Sufficient color contrast between text and backgrounds</li>
          <li>Clear typography, with serif headings and readable body text</li>
          <li>All images include descriptive alt text</li>
          <li>Keyboard-navigable interface</li>
          <li>No content that flashes or blinks</li>
        </ul>
      </section>
      <section class="u-mb-10">
        <h2>Known Limitations</h2>
        <p>
          We are continuously working to improve accessibility. If you encounter any barrier while
          using this Site, please let us know using the form below.
        </p>
      </section>
      <section class="u-mb-12">
        <h2>Report an Accessibility Issue</h2>
        <p class="u-text-muted u-mb-8">
          Found something that's hard to use? Tell us what happened and on which page. We read every
          report and will do our best to fix it.
        </p>
        <form action="https://formspree.io/f/myekwvab" method="POST" class="c-form">
          <div class="c-form-group">
            <label for="page" class="c-form-label">
              Page where the issue occurred
            </label>
            <input
              type="url"
              id="page"
              name="page"
              placeholder="https://senior-living-options.pages.dev/..."
              class="c-form-input"
            />
          </div>
          <div class="c-form-group">
            <label for="issue" class="c-form-label">
              Describe the issue <span aria-hidden="true">*</span>
            </label>
            <textarea
              id="issue"
              name="issue"
              rows="5"
              required
              placeholder="What were you trying to do? What happened? What assistive technology are you using, if any?"
              class="c-form-input"
            ></textarea>
          </div>
          <input type="text" name="_gotcha" style="display:none" />
          <button type="submit" class="c-btn c-btn--primary c-btn--lg">
            Send report
          </button>
        </form>
      </section>
      <section>
        <h2>Standards</h2>
        <p>
          We aim to meet the Web Content Accessibility Guidelines (WCAG) 2.1 Level AA where
          possible. This is an ongoing effort and we welcome feedback to help us improve.
        </p>
      </section>
    </div>
  </main>
  <Footer />
</BaseLayout>
