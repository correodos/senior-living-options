---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SkipLink from '../components/layout/SkipLink.astro';

const SITE_URL = import.meta.env.PUBLIC_SITE_URL || 'https://senior-living-options.pages.dev';

const lastUpdated = 'October 2026';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About Senior Living Options',
  url: `${SITE_URL}/about/`,
  description:
    'Senior Living Options is an independent editorial project dedicated to helping families navigate senior care decisions with clear, source-backed information.',
  publisher: {
    '@type': 'Organization',
    name: 'Senior Living Options',
    url: SITE_URL,
    logo: {
      '@type': 'ImageObject',
      url: `${SITE_URL}/images/logo.webp`,
    },
  },
};
---

<BaseLayout
  title="About | Senior Living Options"
  description="Senior Living Options is an independent editorial project dedicated to helping families navigate senior care decisions with clear, source-backed information."
  canonical={`${SITE_URL}/about/`}
  jsonLd={jsonLd}
>
  <SkipLink />
  <Header />
  <main id="main-content" role="main">
    <div class="u-container u-py-16" style="max-width: 780px; margin: 0 auto;">
      <header class="u-mb-12">
        <p class="c-eyebrow">About this site</p>
        <h1 style="font-family: var(--sl-font-serif);">
          Honest information for one of the hardest decisions families face
        </h1>
        <p class="u-text-muted u-mt-2">Last updated: {lastUpdated}</p>
        <p class="u-text-muted u-fs-lg u-mt-4">
          Senior Living Options is an independent editorial project. No facility listings. No
          sponsored placements. Just clear, researched guides built from primary sources.
        </p>
      </header>
      <section class="u-mb-12" aria-labelledby="mission-title">
        <h2 id="mission-title">Why this site exists</h2>
        <p>
          Searching for senior care information online means wading through facility directories,
          lead-generation forms, and content written to rank — not to help. Families making these
          decisions deserve something better: guides that are honest about costs, clear about what
          Medicare and Medicaid do and don't cover, and upfront about the hard tradeoffs involved.
        </p>
        <p>
          This site was built to fill that gap. Every article starts with a question real families
          ask — "How much does assisted living cost?", "Will Medicaid cover a nursing home?", "When
          is it time for memory care?" — and answers it using the best available primary sources,
          without a sales agenda.
        </p>
      </section>
      <section class="u-mb-12" aria-labelledby="who-title">
        <h2 id="who-title">Who is behind it</h2>
        <p>
          This is a one-person project. There is no corporate agenda, no facility listings, and no
          sponsored placements. Articles are published under the name of the site, and the person
          behind it is not a doctor, nurse, lawyer, or financial advisor.
        </p>
        <p>
          How articles are researched, how figures are checked and updated, and how mistakes are
          corrected are explained in our <a href="/editorial-policy/">Editorial Policy</a>. If you
          find an error or have a suggestion, please <a href="/contact/">contact us</a>.
        </p>
      </section>
      <section aria-labelledby="advice-title">
        <h2 id="advice-title">Not personal advice</h2>
        <p>
          This site does not provide personal legal, financial, or medical advice. For decisions
          specific to your situation, consult a licensed elder law attorney, a certified financial
          planner, or your loved one's physician.
        </p>
      </section>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  section a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
