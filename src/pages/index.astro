---
import { getCollection } from 'astro:content';
import HomeLayout from '../layouts/HomeLayout.astro';
import { buildHomeSEOMeta } from '../utils/seo';
import { getAllCategories, getCategoryDescriptionShort } from '../utils/category';
import Button from '../components/ui/Button.astro';
import StateSelector from '../components/ui/StateSelector.astro';

const allEntries = await getCollection('entries');
const pillars = allEntries
  .filter((e) => e.data.isPillar)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
const latest = allEntries
  .filter((e) => !e.data.isPillar)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 6);

const categories = getAllCategories();
const seo = buildHomeSEOMeta();

const mostRead = [...pillars, ...latest].slice(0, 6);

const faqs = [
  {
    q: 'How much does assisted living cost per month?',
    a: 'The national median is $6,200/month ($74,400/year) as of 2025, according to the CareScout/Genworth Cost of Care Survey. Costs vary significantly by state — from around $4,400/month in lower-cost states like Mississippi to over $9,600/month in Massachusetts or $12,000/month in Hawaii.',
    link: '/article/assisted-living/assisted-living-complete-guide/',
  },
  {
    q: 'Does Medicare cover assisted living or nursing home care?',
    a: 'Medicare does not cover assisted living at all. For nursing homes, Medicare only covers short-term skilled nursing care — up to 100 days per benefit period after a qualifying hospital stay of at least 3 days. After day 100, Medicare pays nothing. Long-term custodial care is not covered.',
    link: '/article/nursing-homes/nursing-homes-complete-guide/',
  },
  {
    q: "What's the difference between memory care and assisted living?",
    a: "Memory care is a specialized form of assisted living for people with Alzheimer's or other dementias. Memory care facilities have secured environments to prevent wandering, staff with dementia-specific training, and adapted programming. Memory care typically costs 15–25% more than standard assisted living — national estimates for 2025–2026 range from $6,690 to $8,019/month.",
    link: '/article/memory-care/memory-care-complete-guide/',
  },
  {
    q: 'Will Medicaid pay for a nursing home or assisted living?',
    a: 'Medicaid covers nursing home care in every state for eligible individuals. For assisted living, 46 states and D.C. offer some coverage through HCBS waiver programs — but this typically covers care services only, not room and board. Eligibility generally requires countable assets below $2,000 and income under ~$2,982/month. Waitlists are common.',
    link: '/article/senior-care-costs/senior-care-costs-complete-guide/',
  },
  {
    q: 'Can VA benefits help pay for senior care?',
    a: 'Yes. The VA Aid & Attendance benefit provides monthly cash payments to eligible wartime veterans and surviving spouses. In 2026, the maximum is $2,424/month for a single veteran, $2,874/month for a veteran with one dependent, and $1,558/month for a surviving spouse. The benefit can be applied to assisted living, in-home care, or nursing home costs.',
    link: '/article/senior-care-costs/senior-care-costs-complete-guide/',
  },
];
---

<HomeLayout {...seo}>
  <section class="c-hero" aria-labelledby="hero-title">
    <div class="u-container">
      <h1 id="hero-title" class="c-hero__title">
        Understanding your senior care
        <br />
        options — <span style="color: var(--sl-color-primary);">without the overwhelm</span>
      </h1>
      <p class="c-hero__description">
        Clear, researched guides to help you choose the right care for your loved one.
      </p>
      <div class="c-hero__actions">
        <Button href="#categories" variant="primary" size="lg">
          Find the right care type →
        </Button>
        <Button href="#state-selector" variant="outline" size="lg">
          Compare costs by state
        </Button>
      </div>
    </div>
  </section>

  <section class="c-trust-bar" aria-label="Trust indicators">
    <div class="u-container">
      <div class="c-trust-bar__marquee-wrapper" aria-hidden="true">
        <ul class="c-trust-bar__marquee u-flex u-items-center u-gap-8">
          <li class="c-trust-bar__item">
            <span class="c-trust-bar__icon" aria-hidden="true">
              ✓
            </span>{' '}
            Researched from government and nonprofit sources
          </li>
          <li class="c-trust-bar__item">
            <span class="c-trust-bar__icon" aria-hidden="true">
              ↻
            </span>{' '}
            Updated 2026
          </li>
          <li class="c-trust-bar__item">
            <span class="c-trust-bar__icon" aria-hidden="true">
              ✓
            </span>{' '}
            Researched from government and nonprofit sources
          </li>
          <li class="c-trust-bar__item">
            <span class="c-trust-bar__icon" aria-hidden="true">
              ↻
            </span>{' '}
            Updated 2026
          </li>
        </ul>
      </div>
      <ul
        class="c-trust-bar__list u-flex-wrap u-justify-center u-hidden sm:u-flex"
        aria-hidden="false"
      >
        <li class="c-trust-bar__item">
          <span class="c-trust-bar__icon" aria-hidden="true">
            ✓
          </span>{' '}
          Researched from government and nonprofit sources
        </li>
        <li class="c-trust-bar__item">
          <span class="c-trust-bar__icon" aria-hidden="true">
            ↻
          </span>{' '}
          Updated 2026
        </li>
      </ul>
    </div>
  </section>

  <section id="categories" class="u-container u-py-16" aria-labelledby="categories-title">
    <header class="u-text-center u-mb-12">
      <p class="c-eyebrow">What type of care do you need?</p>
      <h2 id="categories-title" class="u-mb-4">
        Explore care options by category
      </h2>
      <p class="u-text-muted u-fs-lg u-mx-auto" style="max-width: 600px;">
        Six key areas to help you make informed decisions about senior care
      </p>
    </header>
    <div class="c-grid c-grid--2 c-grid--3">
      {categories.map((cat) => (
        <a href={`/category/${cat.slug}/`} class="c-category-card u-transition">
          <span class="c-category-card__icon" style={{ backgroundColor: cat.bgColor }}>
            {cat.icon}
          </span>
          <h3 class="c-category-card__title">{cat.label}</h3>
          <p class="c-category-card__desc">{getCategoryDescriptionShort(cat.slug)}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="u-container u-py-16" aria-labelledby="most-read-title">
    <header class="u-flex u-items-center u-justify-between u-mb-8">
      <h2 id="most-read-title" class="u-mb-0">
        Most read guides
      </h2>
      <a href="/search/" class="c-btn c-btn--secondary c-btn--sm">
        See all →
      </a>
    </header>
    <div class="c-most-read">
      <ul class="c-most-read__list">
        {mostRead.map((entry) => {
          const cat = categories.find((c) => c.slug === entry.data.category);
          const readingTime =
            entry.data.readingTime || Math.ceil(entry.data.description.length / 200);
          return (
            <li class="c-most-read__item">
              <span
                class="c-badge c-badge--small c-most-read__badge"
                style={{
                  backgroundColor: `${cat?.bgColor}33`,
                  color: cat?.color,
                }}
              >
                {cat?.label}
              </span>
              <div class="c-most-read__content">
                <h3 class="c-most-read__title">
                  <a href={`/article/${entry.id}/`}>{entry.data.title}</a>
                </h3>
                <p class="c-most-read__meta">
                  {readingTime} min read ·{' '}
                  {new Intl.DateTimeFormat('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  }).format(new Date(entry.data.publishDate))}
                </p>
              </div>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <section
    id="state-selector"
    class="u-container u-py-16 u-bg-primary-light"
    aria-labelledby="state-selector-title"
  >
    <StateSelector />
  </section>

  <section class="u-container u-py-16" aria-labelledby="faq-title">
    <h2 id="faq-title" class="u-text-center u-mb-10">
      Quick answers
    </h2>
    <div class="c-faq">
      <div class="c-faq__list">
        {faqs.map((faq) => (
          <details class="c-faq__item">
            <summary class="c-faq__question">{faq.q}</summary>
            <div class="c-faq__answer">
              {faq.a}{' '}
              <a href={faq.link} class="c-faq__link">
                Read more →
              </a>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="u-container u-py-16 u-bg-primary-light" aria-labelledby="checklist-title">
    <div class="u-text-center u-mx-auto" style="max-width: 600px;">
      <h2 id="checklist-title" class="u-mb-4">
        Not sure where to start?
      </h2>
      <ol class="c-checklist">
        <li class="c-checklist__item">
          <span class="c-checklist__number">1</span>Evaluate the level of care needed
        </li>
        <li class="c-checklist__item">
          <span class="c-checklist__number">2</span>Understand your budget and payment options
        </li>
        <li class="c-checklist__item">
          <span class="c-checklist__number">3</span>Research facilities in your area
        </li>
        <li class="c-checklist__item">
          <span class="c-checklist__number">4</span>Visit and ask the right questions
        </li>
      </ol>
      <Button
        href="/article/assisted-living/assisted-living-complete-guide/"
        variant="primary"
        size="lg"
        class="u-mt-8"
      >
        Read the complete guide →
      </Button>
    </div>
  </section>

  <section class="u-container u-py-16 u-bg-primary-light" aria-labelledby="newsletter-title">
    <div class="u-text-center u-mx-auto" style="max-width: 600px;">
      <h2 id="newsletter-title" class="u-mb-4">
        Stay informed
      </h2>
      <p class="u-text-muted u-mb-6">No spam. Unsubscribe anytime.</p>
      <form
        class="c-newsletter__form u-flex u-flex-col sm:u-flex-row u-gap-3 u-mx-auto"
        style="max-width: 400px;"
      >
        <input
          type="email"
          placeholder="you@email.com"
          class="c-newsletter__input u-flex-1"
          aria-label="Email"
          required
        />
        <Button type="submit" variant="primary" size="lg">
          Subscribe
        </Button>
      </form>
      <p class="c-newsletter__note u-fs-xs u-text-light u-mt-4">
        <a href="/privacy/">Privacy policy</a>
      </p>
    </div>
  </section>
</HomeLayout>
