---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import SkipLink from '../../components/layout/SkipLink.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import Button from '../../components/ui/Button.astro';
import StateSelector from '../../components/ui/StateSelector.astro';
import {
  MONTHLY_LABELS,
  SURVEY_YEAR,
  extremes,
  fmtUsd,
  meta,
  national,
  nationalMonthly,
  pctLabel,
  rankLabel,
  similarStates,
  stateFaqs,
  stateSummary,
  states,
  twoYearCosts,
  type MonthlyKey,
} from '../../utils/costs';
import { breadcrumbsToJsonLd, combineJsonLd, generateFAQPageJsonLd } from '../../utils/seo';
import { getMedicaidInfo } from '../../utils/medicaid';

export function getStaticPaths() {
  return states.map((state) => ({
    params: { state: state.code.toLowerCase() },
    props: { code: state.code },
  }));
}

const { code } = Astro.props as { code: string };
const state = states.find((s) => s.code === code)!;

const SITE_URL = import.meta.env.PUBLIC_SITE_URL || 'https://senior-living-options.pages.dev';
const canonical = `${SITE_URL}/costs/${code.toLowerCase()}/`;

const cards: Array<{
  key: MonthlyKey;
  icon: string;
  color: string;
  annual: number | null;
}> = [
  {
    key: 'assistedLiving',
    icon: '🏠',
    color: 'var(--sl-color-al-text)',
    annual: state.assistedLivingAnnual,
  },
  {
    key: 'nursingHomeSemi',
    icon: '🏥',
    color: 'var(--sl-color-nh-text)',
    annual: state.nursingHomeSemiAnnual,
  },
  {
    key: 'nursingHomePrivate',
    icon: '🏥',
    color: 'var(--sl-color-nh-text)',
    annual: state.nursingHomePrivateAnnual,
  },
  {
    key: 'inHomeCare',
    icon: '🏡',
    color: 'var(--sl-color-ihc-text)',
    annual: state.inHomeCareAnnual,
  },
];

const compareKeys: MonthlyKey[] = [
  'assistedLiving',
  'nursingHomeSemi',
  'nursingHomePrivate',
  'inHomeCare',
];

const medicaid = getMedicaidInfo(code);
const faqs = stateFaqs(state);
const similar = similarStates(code);
const twoYears = twoYearCosts(state);

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Costs & Finance', href: '/category/senior-care-costs/' },
  { label: 'Costs by State', href: '/costs/' },
  { label: state.name },
];

const title = `Senior Care Costs in ${state.name} (${SURVEY_YEAR})`;
const description = `${state.name} senior care costs ${SURVEY_YEAR}: assisted living ${fmtUsd(state.assistedLiving)}/mo, nursing home ${fmtUsd(state.nursingHomeSemi)}/mo, in-home care ${fmtUsd(state.inHomeCare)}/mo, compared with U.S. medians.`;

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  url: canonical,
  datePublished: meta.publishedDate,
  dateModified: meta.publishedDate,
  author: { '@type': 'Organization', name: 'Senior Living Options', url: SITE_URL },
  publisher: {
    '@type': 'Organization',
    name: 'Senior Living Options',
    url: SITE_URL,
    logo: { '@type': 'ImageObject', url: `${SITE_URL}/images/logo.webp` },
  },
  isPartOf: { '@type': 'WebSite', name: 'Senior Living Options', url: SITE_URL },
};

const jsonLd = combineJsonLd(
  articleJsonLd,
  breadcrumbsToJsonLd(breadcrumbs, canonical),
  generateFAQPageJsonLd(faqs)
);
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <SkipLink />
  <Header />
  <main id="main-content" role="main">
    <div class="u-container u-py-4">
      <Breadcrumbs items={breadcrumbs} />
    </div>

    <header class="u-container u-py-10">
      <p class="c-eyebrow">Senior Care Costs {SURVEY_YEAR}</p>
      <h1 class="state-title">Senior Care Costs in {state.name}</h1>
      <p class="state-summary">{stateSummary(state)}</p>
    </header>

    <section class="u-container u-pb-12" aria-labelledby="medians-heading">
      <h2 id="medians-heading" class="state-h2">
        Median monthly costs in {state.name}
      </h2>
      <div class="c-grid c-grid--2">
        {cards.map((card) => {
          const value = state[card.key];
          return (
            <div class="c-card cost-card" style={`border-top: 3px solid ${card.color};`}>
              <div class="c-card__content">
                <p class="c-eyebrow" style={`color: ${card.color};`}>
                  {card.icon} {MONTHLY_LABELS[card.key]}
                </p>
                <p class="cost-value">
                  {fmtUsd(value)}
                  {value !== null && <span class="cost-unit">/mo</span>}
                </p>
                {value !== null ? (
                  <>
                    <p class="cost-pct">{pctLabel(value, card.key)}</p>
                    <p class="cost-meta">{rankLabel(code, card.key)}</p>
                    <p class="cost-meta">
                      {fmtUsd(card.annual)} per year · National median:{' '}
                      {fmtUsd(nationalMonthly(card.key))}/mo
                    </p>
                  </>
                ) : (
                  <p class="cost-meta">
                    CareScout did not have enough data to report this figure for {state.name}.
                  </p>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <section class="u-container u-pb-12" aria-labelledby="more-heading">
      <h2 id="more-heading" class="state-h2">
        Other care options in {state.name}
      </h2>
      <div class="c-grid c-grid--3">
        <div class="c-card cost-card">
          <div class="c-card__content">
            <p class="c-eyebrow">Adult day health care</p>
            <p class="cost-value">
              {fmtUsd(state.adultDayDaily)}
              {state.adultDayDaily !== null && <span class="cost-unit">/day</span>}
            </p>
            <p class="cost-meta">
              {state.adultDayAnnual !== null
                ? `${fmtUsd(state.adultDayAnnual)} per year at 5 days a week`
                : 'Not enough data reported for this state'}
            </p>
            <p class="cost-meta">National median: {fmtUsd(national.adultDay.daily)}/day</p>
          </div>
        </div>
        <div class="c-card cost-card">
          <div class="c-card__content">
            <p class="c-eyebrow">Non-medical caregiver</p>
            <p class="cost-value">
              {fmtUsd(state.inHomeCareHourly)}
              <span class="cost-unit">/hour</span>
            </p>
            <p class="cost-meta">{fmtUsd(state.inHomeCareAnnual)} per year at 44 hours a week</p>
            <p class="cost-meta">National median: {fmtUsd(national.inHomeCare.hourly)}/hour</p>
          </div>
        </div>
        <div class="c-card cost-card">
          <div class="c-card__content">
            <p class="c-eyebrow">Private duty nurse (in the home)</p>
            <p class="cost-value">
              {fmtUsd(state.privateDutyNurseHourly)}
              {state.privateDutyNurseHourly !== null && <span class="cost-unit">/hour</span>}
            </p>
            <p class="cost-meta">
              {state.privateDutyNurseHourly !== null
                ? 'Licensed nursing care provided at home'
                : 'Not enough data reported for this state'}
            </p>
            <p class="cost-meta">
              National median: {fmtUsd(national.privateDutyNurse.hourly)}/hour
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="u-container u-pb-12" aria-labelledby="compare-heading">
      <h2 id="compare-heading" class="state-h2">
        How {state.name} compares
      </h2>
      <div class="state-table-wrap">
        <table class="state-table">
          <thead>
            <tr>
              <th scope="col">Monthly median</th>
              <th scope="col">{state.name}</th>
              <th scope="col">U.S. median</th>
              <th scope="col">Lowest state</th>
              <th scope="col">Highest state</th>
            </tr>
          </thead>
          <tbody>
            {compareKeys.map((key) => {
              const { highest, lowest } = extremes(key);
              return (
                <tr>
                  <th scope="row">{MONTHLY_LABELS[key]}</th>
                  <td>{fmtUsd(state[key])}</td>
                  <td>{fmtUsd(nationalMonthly(key))}</td>
                  <td>
                    <a href={`/costs/${lowest.code.toLowerCase()}/`}>{lowest.name}</a>{' '}
                    {fmtUsd(lowest[key])}
                  </td>
                  <td>
                    <a href={`/costs/${highest.code.toLowerCase()}/`}>{highest.name}</a>{' '}
                    {fmtUsd(highest[key])}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>

    <section class="u-container u-pb-12" aria-labelledby="two-years-heading">
      <h2 id="two-years-heading" class="state-h2">
        What two years of care could cost
      </h2>
      <p class="state-note">
        Illustrative totals using the {state.name} monthly median multiplied by 24 months. Actual
        costs depend on the community, the level of care, and annual price increases.
      </p>
      <div class="state-table-wrap">
        <table class="state-table">
          <thead>
            <tr>
              <th scope="col">Care type</th>
              <th scope="col">Two-year estimate</th>
            </tr>
          </thead>
          <tbody>
            {twoYears.map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                <td>{row.total === null ? 'N/A' : fmtUsd(row.total)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="u-container u-pb-12" aria-labelledby="similar-heading">
      <h2 id="similar-heading" class="state-h2">
        States with similar costs
      </h2>
      <p class="state-note">
        These states have median assisted living, nursing home, and in-home care costs closest to
        {state.name}.
      </p>
      <ul class="state-links">
        {similar.map((other) => (
          <li>
            <a href={`/costs/${other.code.toLowerCase()}/`}>{other.name}</a>
            <span>
              Assisted living {fmtUsd(other.assistedLiving)}/mo · Nursing home{' '}
              {fmtUsd(other.nursingHomeSemi)}/mo
            </span>
          </li>
        ))}
      </ul>
      <p class="state-note">
        <a href="/costs/">Compare senior care costs in all 50 states →</a>
      </p>
    </section>

    {medicaid && (
      <section class="u-container u-pb-12" aria-labelledby="medicaid-heading">
        <h2 id="medicaid-heading" class="state-h2">
          Paying with Medicaid in {state.name}
        </h2>
        <p class="state-note">
          Medicaid can help pay for nursing home care when a person's income and assets are within
          the limits set by their state. Rules differ from state to state and change over time, so
          confirm the current figures with the agency before making decisions.
        </p>
        {medicaid.facts.length > 0 ? (
          <dl class="medicaid-facts">
            {medicaid.facts.map((fact) => (
              <div class="medicaid-fact">
                <dt>{fact.label}</dt>
                <dd>
                  <strong>{fact.value}</strong>
                  <span class="medicaid-source">
                    Source:{' '}
                    <a href={fact.source} rel="noopener">
                      {fact.sourceHost}
                    </a>
                    {fact.detail}
                  </span>
                </dd>
              </div>
            ))}
          </dl>
        ) : (
          <p class="state-note">
            We have not yet verified {state.name}'s specific Medicaid limits against official
            sources, so we do not show them here.
          </p>
        )}
        <p class="state-note">
          <a href={medicaid.agency.url} rel="noopener">
            Apply or get help: {medicaid.agency.name} →
          </a>
        </p>
        <p class="state-note medicaid-disclaimer">
          This is general information, not legal or financial advice. An elder law attorney or your
          state agency can explain how the rules apply to a specific situation.
        </p>
      </section>
    )}

    <section class="u-container u-pb-12" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="state-h2">
        Frequently asked questions about costs in {state.name}
      </h2>
      {faqs.map((faq) => (
        <div class="state-faq">
          <h3>{faq.question}</h3>
          <p>{faq.answer}</p>
        </div>
      ))}
    </section>

    <section class="u-container u-pb-12">
      <div class="u-flex u-gap-4 u-flex-wrap">
        <Button
          href="/article/senior-care-costs/senior-care-costs-complete-guide/"
          variant="primary"
          size="lg"
        >
          How to pay for senior care →
        </Button>
        <Button href="/category/senior-care-costs/" variant="outline" size="lg">
          More cost guides
        </Button>
      </div>
    </section>

    <section
      class="u-container u-py-10 u-bg-primary-light u-rounded-lg"
      aria-labelledby="methodology-heading"
    >
      <h2 id="methodology-heading" class="state-h2">
        Methodology and sources
      </h2>
      <div class="u-flex u-flex-col u-gap-4 u-fs-sm u-text-muted">
        <p>
          <strong>Data source:</strong>
          {meta.source}, published by CareScout (Genworth) in {meta.published}. Rates were collected
          from long-term care providers between {meta.dataCollection}.
        </p>
        <p>
          <strong>How figures are calculated:</strong> Assisted living is the median monthly rate
          for a private one-bedroom unit. Nursing home figures are median monthly rates for
          semi-private and private rooms. In-home care assumes 44 hours of non-medical care per
          week, and adult day health care assumes five days per week. Annual figures are the
          reported annual medians; monthly figures are the annual rate divided by 12.
        </p>
        <p>
          <strong>Keep in mind:</strong> These are state-level medians. Costs can differ
          significantly between cities and counties, and between individual communities. Use them to
          plan and to ask better questions, and confirm current prices directly with providers.
        </p>
      </div>
    </section>

    <section class="u-container u-py-16 u-bg-primary-light u-mt-8">
      <StateSelector
        label="Compare another state"
        subtitle="Select a different state to see its costs"
      />
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .state-title {
    font-family: var(--sl-font-serif);
  }
  .state-summary {
    margin-top: var(--sl-space-3);
    font-size: var(--sl-fs-lg);
    line-height: var(--sl-lh-relaxed);
    color: var(--sl-color-text-muted);
  }
  .state-h2 {
    font-family: var(--sl-font-serif);
    font-size: var(--sl-fs-2xl);
    margin-bottom: var(--sl-space-6);
  }
  .state-note {
    margin-bottom: var(--sl-space-4);
    color: var(--sl-color-text-muted);
  }
  .cost-value {
    font-family: var(--sl-font-serif);
    font-size: var(--sl-fs-3xl);
    font-weight: 700;
    margin: var(--sl-space-2) 0;
  }
  .cost-unit {
    font-family: var(--sl-font-sans);
    font-size: var(--sl-fs-base);
    font-weight: 400;
    color: var(--sl-color-text-muted);
  }
  .cost-pct {
    font-size: var(--sl-fs-sm);
    font-weight: 600;
  }
  .cost-meta {
    margin-top: var(--sl-space-1);
    font-size: var(--sl-fs-sm);
    color: var(--sl-color-text-muted);
  }
  .state-table-wrap {
    overflow-x: auto;
    border: 1px solid var(--sl-color-border);
    border-radius: var(--sl-radius-lg);
  }
  .state-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--sl-fs-sm);
  }
  .state-table th,
  .state-table td {
    padding: var(--sl-space-3) var(--sl-space-4);
    text-align: left;
    border-bottom: 1px solid var(--sl-color-border);
    vertical-align: top;
  }
  .state-table thead th {
    background-color: var(--sl-color-primary);
    color: var(--sl-color-primary-text);
    white-space: nowrap;
  }
  .state-table td a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .state-table tbody tr:last-child th,
  .state-table tbody tr:last-child td {
    border-bottom: none;
  }
  .state-table tbody th {
    font-weight: 600;
  }
  .state-links {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--sl-space-4);
    display: grid;
    gap: var(--sl-space-3);
  }
  .state-links li {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sl-space-1) var(--sl-space-4);
    align-items: baseline;
  }
  .state-links a {
    font-weight: 600;
  }
  .state-links span {
    font-size: var(--sl-fs-sm);
    color: var(--sl-color-text-muted);
  }
  .medicaid-facts {
    display: grid;
    gap: var(--sl-space-3);
    margin: 0 0 var(--sl-space-4);
  }
  .medicaid-fact {
    border: 1px solid var(--sl-color-border);
    border-radius: var(--sl-radius-lg);
    padding: var(--sl-space-4);
  }
  .medicaid-fact dt {
    font-weight: 600;
    margin-bottom: var(--sl-space-1);
  }
  .medicaid-fact dd {
    margin: 0;
  }
  .medicaid-fact strong {
    font-size: var(--sl-fs-xl);
  }
  .medicaid-source {
    display: block;
    margin-top: var(--sl-space-1);
    font-size: var(--sl-fs-sm);
    color: var(--sl-color-text-muted);
  }
  .medicaid-source a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .medicaid-disclaimer {
    font-size: var(--sl-fs-sm);
  }
  .state-faq {
    margin-bottom: var(--sl-space-6);
  }
  .state-faq h3 {
    font-size: var(--sl-fs-xl);
    margin-bottom: var(--sl-space-2);
  }
  .state-faq p {
    line-height: var(--sl-lh-relaxed);
  }
</style>
