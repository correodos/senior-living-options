---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SkipLink from '../components/layout/SkipLink.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';

interface Props {
  title: string;
  description: string;
  category: string;
  canonical?: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown> | null;
}
const { title, description, category, ...rest } = Astro.props;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  {
    label: title.replace(' - Guides & Articles | Senior Living Options', ''),
    href: `/category/${category}/`,
  },
];
---

<BaseLayout title={title} description={description} {...rest}>
  <SkipLink />
  <Header />
  <main id="main-content" role="main">
    <div class="u-container u-py-4">
      <Breadcrumbs items={breadcrumbs} />
    </div>
    <slot />
  </main>
  <Footer />
</BaseLayout>
