---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | null;
  robots?: string;
  noFollow?: boolean;
}
const {
  title,
  description,
  canonical,
  ogImage,
  ogType = 'website',
  jsonLd,
  robots = 'index,follow',
  noFollow = false,
} = Astro.props;

const SITE_URL = import.meta.env.PUBLIC_SITE_URL || 'https://seniorcareexplained.com';
const SITE_NAME = import.meta.env.PUBLIC_SITE_NAME || 'Senior Care Explained';
const DEFAULT_OG_IMAGE = `${SITE_URL}/images/og-default.jpg`;
const finalCanonical = canonical || Astro.url.href;
const finalOgImage = ogImage || DEFAULT_OG_IMAGE;
// Google shows about 60 characters of the title, so the site name is only appended when it fits.
const MAX_TITLE_LENGTH = 60;
const titleWithSiteName = `${title} | ${SITE_NAME}`;
const finalTitle =
  title.includes(SITE_NAME) || titleWithSiteName.length > MAX_TITLE_LENGTH
    ? title
    : titleWithSiteName;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.setAttribute(
            'data-theme',
            saved || (prefersDark ? 'dark' : 'light')
          );
        } catch (e) {}
      })();
    </script>
    {import.meta.env.PROD && (
      <>
        <script
          is:inline
          async
          src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3954825763005364"
          crossorigin="anonymous"
        ></script>
        <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-MXCFBFK97E" />
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          gtag('js', new Date());
          gtag('config', 'G-MXCFBFK97E');
        </script>
      </>
    )}
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={finalCanonical} />
    <meta name="robots" content={noFollow ? robots.replace('follow', 'nofollow') : robots} />

    <title>{finalTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={finalCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={finalOgImage} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={finalOgImage} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
  </head>
  <body>
    <slot />
  </body>
</html>
