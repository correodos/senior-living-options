---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SkipLink from '../components/layout/SkipLink.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown> | null;
}
const {
  title = 'Senior Living Options - Guías Completas para Opciones de Vivienda y Cuidado',
  description = 'Encuentra la mejor opción de vivienda y cuidado para tu ser querido. Guías expertas sobre Assisted Living, Memory Care, Nursing Homes, In-Home Care, costos y recursos para cuidadores.',
  ...rest
} = Astro.props;
---

<BaseLayout title={title} description={description} {...rest}>
  <SkipLink />
  <Header />
  <main id="main-content" role="main">
    <slot />
  </main>
  <Footer />
</BaseLayout>
