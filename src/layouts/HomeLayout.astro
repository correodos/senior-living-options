---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SkipLink from '../components/layout/SkipLink.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown> | null;
}
const {
  title = 'Senior Living Options - Complete Guides for Senior Living and Care Options',
  description = 'Find the best care option for your loved one. Expert guides on Assisted Living, Memory Care, Nursing Homes, In-Home Care, costs, and caregiver resources.',
  ...rest
} = Astro.props;
---

<BaseLayout title={title} description={description} {...rest}>
  <SkipLink />
  <Header />
  <main id="main-content" role="main">
    <slot />
  </main>
  <Footer />
</BaseLayout>
