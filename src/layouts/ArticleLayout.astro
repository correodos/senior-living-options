---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SkipLink from '../components/layout/SkipLink.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import ArticleMeta from '../components/content/ArticleMeta.astro';
import TableOfContents from '../components/content/TableOfContents.astro';
import { getCategoryInfo } from '../utils/category';
import { getTableOfContents } from '../utils/markdown';

interface Props {
  title: string;
  description: string;
  data: any;
  slug: string;
  content: string;
  canonical?: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown> | null;
}
const { title, description, data, slug, content, ...rest } = Astro.props;

const categoryInfo = getCategoryInfo(data.category);
const breadcrumbs = [
  { label: 'Inicio', href: '/' },
  { label: categoryInfo?.label || data.category, href: `/category/${data.category}/` },
  { label: data.title },
];

const tocHeadings = getTableOfContents(content);
---

<BaseLayout title={title} description={description} {...rest}>
  <SkipLink />
  <Header />
  <main id="main-content" role="main" class="u-container u-py-8 u-flex u-gap-8">
    <nav
      class="u-w-full u-hidden lg:u-block"
      style="width: 280px; flex-shrink: 0;"
      aria-label="Ruta de navegación"
    >
      <Breadcrumbs items={breadcrumbs} />
    </nav>

    <div class="u-flex-1 u-flex u-flex-col u-gap-8" style="min-width: 0;">
      <nav class="u-hidden lg:u-block" aria-label="Ruta de navegación">
        <Breadcrumbs items={breadcrumbs} />
      </nav>

      <article>
        <header class="u-mb-8">
          {data.isPillar && (
            <span class="c-badge c-badge--pillar u-mb-4 u-inline-block">Artículo Pilar</span>
          )}
          <h1 class="u-mb-4">{data.title}</h1>
          <ArticleMeta data={data} />
        </header>

        <div class="u-flex u-gap-8">
          <div class="u-flex-1" style="min-width: 0;" set:html={content} />

          {tocHeadings.length > 0 && (
            <aside class="u-hidden lg:u-block" style="width: 260px; flex-shrink: 0;">
              <TableOfContents headings={tocHeadings} />
            </aside>
          )}
        </div>
      </article>
    </div>
  </main>
  <Footer />
</BaseLayout>
