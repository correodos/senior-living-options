---
import { heroImageUrl, responsiveSrcset } from '../../utils/images';

interface Props {
  entry: any;
  featured?: boolean;
  priority?: boolean;
}
const { entry, priority = false } = Astro.props;
const { data, id } = entry;
const slug = id.replace(/\\/g, '/');
const imageUrl = heroImageUrl(data.image) ?? '/images/og-default.jpg';
const imageSrcset = responsiveSrcset(imageUrl);
const imageAlt = data.imageAlt || data.title;
const categoryInfo = {
  'assisted-living': {
    label: 'Assisted Living',
    color: 'var(--sl-color-al-text)',
    bg: 'var(--sl-color-al-bg)',
  },
  'memory-care': {
    label: 'Memory Care',
    color: 'var(--sl-color-mc-text)',
    bg: 'var(--sl-color-mc-bg)',
  },
  'nursing-homes': {
    label: 'Nursing Homes',
    color: 'var(--sl-color-nh-text)',
    bg: 'var(--sl-color-nh-bg)',
  },
  'in-home-care': {
    label: 'In-Home Care',
    color: 'var(--sl-color-ihc-text)',
    bg: 'var(--sl-color-ihc-bg)',
  },
  'senior-care-costs': {
    label: 'Costs & Finance',
    color: 'var(--sl-color-cf-text)',
    bg: 'var(--sl-color-cf-bg)',
  },
  'caregiver-resources': {
    label: 'Caregiver Help',
    color: 'var(--sl-color-cr-text)',
    bg: 'var(--sl-color-cr-bg)',
  },
};
const cat = categoryInfo[data.category as keyof typeof categoryInfo] || {
  label: data.category,
  color: 'var(--sl-color-primary)',
  bg: 'var(--sl-color-primary-light)',
};
---

<article class="c-card" itemscope itemtype="https://schema.org/Article">
  <a href={`/article/${slug}/`} class="c-card__link" aria-label={`Read: ${data.title}`}>
    <img
      src={imageUrl}
      alt={imageAlt}
      class="c-card__image"
      srcset={imageSrcset}
      sizes={imageSrcset ? '(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw' : undefined}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
      decoding="async"
      width="400"
      height="225"
    />
  </a>
  <div class="c-card__content">
    <div class="u-flex u-items-center u-gap-2 u-mb-2">
      <span class="c-badge" style={{ backgroundColor: cat.bg, color: cat.color }}>
        {cat.label}
      </span>
      {data.isPillar && <span class="c-badge c-badge--pillar">Pillar Article</span>}
    </div>
    <h2 class="c-card__title" itemprop="headline">
      <a href={`/article/${slug}/`}>{data.title}</a>
    </h2>
    <p class="c-card__excerpt" itemprop="description">
      {data.description}
    </p>
    <div class="c-card__meta">
      <time itemprop="datePublished" datetime={data.publishDate.toISOString()}>
        {new Intl.DateTimeFormat('en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        }).format(new Date(data.publishDate))}
      </time>
      {data.readingTime && <span>{data.readingTime} min read</span>}
    </div>
  </div>
</article>
