---
import { getAllCategories } from '../../utils/category';
const categories = getAllCategories();
---

<header class="c-header" role="banner">
  <div class="c-header__inner u-container u-flex u-items-center u-justify-between">
    <a href="/" class="c-header__logo" aria-label="Senior Living Options - Home">
      <svg class="c-header__logo-icon" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <circle cx="16" cy="16" r="14" stroke="currentColor" stroke-width="2" />
        <path
          d="M16 8v8M12 12h8M16 16v8M12 20h8"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        />
      </svg>
      <span class="c-header__logo-text">
        <span class="c-header__logo-primary">Senior</span>
        <span class="c-header__logo-secondary">Living</span>
        <span class="c-header__logo-primary">Options</span>
      </span>
    </a>

    <nav class="c-header__nav" role="navigation" aria-label="Main navigation">
      {categories.map((cat) => (
        <a href={`/category/${cat.slug}/`} class="c-header__nav-link">
          {cat.label}
        </a>
      ))}
      <a href="/about/" class="c-header__nav-link">
        About
      </a>
    </nav>

    <button
      class="c-header__theme-toggle"
      aria-label="Toggle dark mode"
      title="Toggle theme"
      data-theme-toggle-header
    >
      <svg
        class="c-theme-icon c-theme-icon--sun"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="5"></circle>
        <line x1="12" y1="1" x2="12" y2="3"></line>
        <line x1="12" y1="21" x2="12" y2="23"></line>
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
        <line x1="1" y1="12" x2="3" y2="12"></line>
        <line x1="21" y1="12" x2="23" y2="12"></line>
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
      </svg>
      <svg
        class="c-theme-icon c-theme-icon--moon"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
    </button>

    <button
      class="c-header__mobile-toggle"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
      data-mobile-toggle
    >
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
    </button>
  </div>

  <div
    class="c-header__mobile-menu u-hidden"
    id="mobile-menu"
    role="navigation"
    aria-label="Mobile menu"
  >
    <nav class="u-p-4 u-flex u-flex-col u-gap-2">
      {categories.map((cat) => (
        <a href={`/category/${cat.slug}/`} class="c-header__nav-link u-py-2">
          {cat.label}
        </a>
      ))}
      <a href="/about/" class="c-header__nav-link u-py-2">
        About
      </a>
      <a href="/search/" class="c-btn c-btn--primary u-mt-4">
        Search
      </a>
    </nav>
  </div>
</header>

<style>
  .c-header__theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--sl-color-border);
    border-radius: var(--sl-radius-full);
    background: transparent;
    color: var(--sl-color-text-muted);
    cursor: pointer;
    transition: all var(--sl-transition-fast);
    margin-right: var(--sl-space-2);
  }
  .c-header__theme-toggle:hover {
    background: var(--sl-color-primary-light);
    border-color: var(--sl-color-primary);
    color: var(--sl-color-primary);
  }
  .c-header__theme-toggle:focus-visible {
    outline: 2px solid var(--sl-color-border-focus);
    outline-offset: 2px;
  }
  .c-theme-icon {
    display: inline-block;
  }
  .c-theme-icon--moon {
    display: none;
  }
  [data-theme='dark'] .c-theme-icon--sun {
    display: none;
  }
  [data-theme='dark'] .c-theme-icon--moon {
    display: inline-block;
  }
</style>

<script>
  // Global theme init — runs on every page before first paint
  (function () {
    const saved = localStorage.getItem('theme');
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const theme = saved || (prefersDark ? 'dark' : 'light');
    document.documentElement.setAttribute('data-theme', theme);
  })();

  const toggle = document.querySelector('[data-mobile-toggle]');
  const menu = document.getElementById('mobile-menu');

  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isOpen));
      menu.classList.toggle('u-hidden');
    });

    document.addEventListener('click', (e) => {
      const target = e.target as Node;
      if (!toggle.contains(target) && !menu.contains(target)) {
        toggle.setAttribute('aria-expanded', 'false');
        menu.classList.add('u-hidden');
      }
    });
  }

  // Header theme toggle
  const themeBtn = document.querySelector('[data-theme-toggle-header]');
  if (themeBtn) {
    themeBtn.addEventListener('click', () => {
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      const newTheme = isDark ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', newTheme);
      localStorage.setItem('theme', newTheme);
    });
  }
</script>
